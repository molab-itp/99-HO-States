# Copy to .env.local (gitignored) and fill in. Same two values as v07's .env.local and v2's Supabase.plist.

# Dashboard > Project Settings > API. Local stack: http://127.0.0.1:54321
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable (or legacy anon) key. Safe to ship in the page; RLS is what protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
